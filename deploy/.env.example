# 3D建模工作室环境配置
PORT=3000
NODE_ENV=production

# 数据存储路径
DB_PATH=/workspace/data/3d-modeling-studio/db.json
UPLOAD_DIR=/workspace/data/3d-modeling-studio/uploads
MODEL_DIR=/workspace/data/3d-modeling-studio/models

# Forge3D 异步建模服务
SPU_PROVIDER=forge3d
SPU_API_URL=http://127.0.0.1:8091/v1/jobs
SPU_API_KEY=
FORGE3D_ASSET_ROOT=/workspace/3d-assets

# 统一账号中心（Algorithm Lab SSO）
# PUBLIC_URL 必须与账号中心 SSO_CLIENTS_JSON 里本 client 的 redirectUri 完全一致
SSO_AUTH_BASE_URL=https://gsy-gpu.tail660bdf.ts.net
PUBLIC_URL=

# 结果通知（也可在网页设置中填写；环境变量优先）
NOTIFY_EMAIL_TO=
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
FEISHU_WEBHOOK=
WECOM_WEBHOOK=

# Skill 解析服务（服务器本机 Qwen，兼容 chat/completions）
SKILL_PLANNER_URL=http://127.0.0.1:8002/v1/chat/completions
SKILL_PLANNER_MODEL=qwen3.5-9b-fp8
