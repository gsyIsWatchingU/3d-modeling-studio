# 服务器配置
PORT=3000
NODE_ENV=production

# 文件存储路径
UPLOAD_DIR=/data/uploads
MODEL_DIR=/data/models
DB_PATH=/data/db.json

# 统一账号中心（Algorithm Lab SSO）
# SSO_AUTH_BASE_URL 指向账号中心公网地址；PUBLIC_URL 是本站点公网地址（SSO 回跳用，必须与账号中心注册的 redirectUri 一致）
SSO_AUTH_BASE_URL=https://gsy-gpu.tail660bdf.ts.net
PUBLIC_URL=https://<本站点公网地址>
# SSO_CLIENT_ID=3d-modeling-studio

# Forge3D 异步建模服务（也可以在网页上配置）
SPU_PROVIDER=forge3d
SPU_API_URL=http://127.0.0.1:8091/v1/jobs
SPU_API_KEY=
FORGE3D_ASSET_ROOT=/workspace/3d-assets

# 通知配置（环境变量优先，也可以在网页设置中填写）
NOTIFY_EMAIL_TO=
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
FEISHU_WEBHOOK=
WECOM_WEBHOOK=

# Skill 解析服务（服务器本机 Qwen，兼容 chat/completions）
SKILL_PLANNER_URL=http://127.0.0.1:8002/v1/chat/completions
SKILL_PLANNER_MODEL=qwen3.5-9b-fp8

# 游戏工厂默认复用上面的文字模型；可单独指定
# FACTORY_PLANNER_URL=http://127.0.0.1:8002/v1/chat/completions
# FACTORY_PLANNER_MODEL=qwen3.5-9b-fp8
# FACTORY_DIR=/data/game-factory
