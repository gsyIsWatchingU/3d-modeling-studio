# 服务器配置
PORT=3000
NODE_ENV=production

# 文件存储路径
UPLOAD_DIR=/data/uploads
MODEL_DIR=/data/models
DB_PATH=/data/db.json

# Forge3D 异步建模服务（也可以在网页上配置）
SPU_PROVIDER=forge3d
SPU_API_URL=http://127.0.0.1:8091/v1/jobs
SPU_API_KEY=
FORGE3D_ASSET_ROOT=/workspace/3d-assets

# 通知配置（环境变量优先，也可以在网页设置中填写）
NOTIFY_EMAIL_TO=
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
FEISHU_WEBHOOK=
WECOM_WEBHOOK=
